# Configurações do Servidor Local
PORT=3000

# Configurações do WAHA
WAHA_URL=https://waha.ngrok.dev
WAHA_SESSION=atendimento
WAHA_API_KEY=seu_api_key_aqui
WAHA_USER=seu_usuario_waha
WAHA_PASSWORD=sua_senha_waha

# Configurações do Supabase (Flow Lab Auth)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anonima-supabase-aqui

# Agente Copiloto de Atendimento — apLIS (leitura, ver lib/aplis/client.js)
APLIS_BASE_URL=https://lab.aplis.inf.br/api/integracao.php
APLIS_USUARIO=seu_usuario_aplis
APLIS_SENHA=sua_senha_aplis

# Agente Copiloto — Gemini (classificação de intenção e redator; ver lib/agent/)
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-3.5-flash-lite
AGENT_CONFIANCA_MINIMA=0.6
AGENT_TETO_DIARIO=200

# Agente Copiloto — banco espelho do apLIS, MySQL, só leitura (ver
# lib/db/mirrorClient.js e design.md, "Cortesia/convênio: banco espelho, não
# a API"). Ausente = a 4ª capacidade (situacao_pagamento) fica sempre sem
# sugestão, o resto do agente funciona igual. Use um usuário com GRANT SELECT
# restrito a requisicao/fatinstituicao/fatconvenio (nunca root/superusuário)
# — em produção, peça esse usuário à TI do laboratório antes de configurar.
DB_HOST=seu_host_do_espelho
DB_PORT=3306
DB_USER=usuario_com_select_apenas
DB_PASSWORD=sua_senha_aqui
DB_NAME=nome_do_banco

